{
  "name": "pangram-solver-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pangram finder for seven-letter Spelling Bee games.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test",
    "benchmark": "node scripts/build.mjs && node --expose-gc scripts/benchmark.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
